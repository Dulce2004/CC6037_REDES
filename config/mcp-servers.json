{
  "variables": ["MCP_GIT_REPOSITORY_PATH", "MCP_FILESYSTEM_ROOT"],
  "servers": [
    {
      "name": "pharmacy",
      "transport": "stdio",
      "command": "${PYTHON_EXECUTABLE}",
      "args": ["-B", "-m", "pharmacy_mcp.server.stdio"],
      "cwd": "..",
      "env": {
        "PYTHONPATH": "src",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "request_timeout_seconds": 10,
      "shutdown_timeout_seconds": 5,
      "enabled": true
    },
    {
      "name": "git",
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "mcp-server-git==2026.8.18",
        "mcp-server-git",
        "--repository",
        "${MCP_GIT_REPOSITORY_PATH}"
      ],
      "cwd": "${MCP_GIT_REPOSITORY_PATH}",
      "env": {},
      "request_timeout_seconds": 30,
      "shutdown_timeout_seconds": 10,
      "enabled": true,
      "repository_policy": {
        "root": "${MCP_GIT_REPOSITORY_PATH}",
        "argument": "repo_path",
        "mutable_tools": [
          "git_add",
          "git_commit",
          "git_reset",
          "git_checkout",
          "git_create_branch"
        ]
      }
    },
    {
      "name": "filesystem",
      "transport": "stdio",
      "command": "${NPX_EXECUTABLE}",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.8.31",
        "${MCP_FILESYSTEM_ROOT}"
      ],
      "cwd": "${MCP_FILESYSTEM_ROOT}",
      "env": {},
      "request_timeout_seconds": 60,
      "shutdown_timeout_seconds": 10,
      "enabled": true,
      "filesystem_policy": {
        "root": "${MCP_FILESYSTEM_ROOT}",
        "path_arguments": ["path", "paths", "source", "destination"],
        "creation_arguments": {
          "write_file": ["path"],
          "create_directory": ["path"],
          "move_file": ["destination"]
        }
      }
    }
  ]
}
